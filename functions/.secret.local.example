# Cloud Functions ローカル emulator 用シークレット値
#
# このファイルを .secret.local にコピーして値を設定してください。
# .secret.local は .gitignore 済みで、Firebase Functions emulator が自動で読み込みます。
# 本番環境では代わりに Google Cloud Secret Manager を使います:
#   firebase functions:secrets:set RESEND_API_KEY
#   firebase functions:secrets:set RESEND_FROM   # 任意（送信元アドレス上書き）

RESEND_API_KEY=
RESEND_FROM=
