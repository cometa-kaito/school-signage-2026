{
  "name": "signage-functions",
  "description": "Cloud Functions for Signage Admin",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p jsconfig.json"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.5.0",
    "resend": "^6.12.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "private": true
}
