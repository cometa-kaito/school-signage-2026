rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ========================================
    // ヘルパー関数
    // ========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
        && (request.auth.token.admin == true || request.auth.token.systemRole == 'system_admin');
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidVideoType() {
      return request.resource.contentType.matches('video/.*');
    }

    function isValidMediaType() {
      return isValidImageType() || isValidVideoType();
    }

    function isValidFileSize() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    // ========================================
    // サイネージ用メディアファイル
    // ========================================

    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && isValidImageType()
        && isValidFileSize();
    }

    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && isValidVideoType()
        && request.resource.size < 100 * 1024 * 1024;
    }

    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && isValidMediaType()
        && isValidFileSize();
    }

    match /contents/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && isValidMediaType()
        && isValidFileSize();
    }

    // ========================================
    // 学校別メディアフォルダ（マルチテナント対応）
    // ========================================

    match /schools/{schoolId}/{allPaths=**} {
      allow read: if true;
      // 管理者または認証済みユーザー（メンバーシップはCloud Functions側で検証）
      allow write: if isAuthenticated()
        && isValidMediaType()
        && isValidFileSize();
    }

    // ========================================
    // 管理者用プライベートフォルダ
    // ========================================

    match /private/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // ========================================
    // 広告画像フォルダ
    // ========================================

    match /ads/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
        && isValidImageType()
        && isValidFileSize();
    }

    // ========================================
    // サイネージデータJSON（Cloud Functionsが生成）
    // ========================================

    match /signage-data/{schoolId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // ========================================
    // デフォルト：その他すべて拒否
    // ========================================

    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
