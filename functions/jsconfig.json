{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "node",
        "checkJs": true,
        "allowJs": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "strict": false,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "maxNodeModuleJsDepth": 0,
        "types": ["node"],
        "baseUrl": "."
    },
    "include": [
        "helpers/**/*.js",
        "types.d.ts"
    ],
    "exclude": [
        "node_modules",
        "__tests__",
        "**/*.test.js"
    ]
}
