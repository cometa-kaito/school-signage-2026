rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // ヘルパー関数
    // ========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      return request.auth != null && request.auth.token.systemRole == 'system_admin';
    }

    function isLegacyAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function hasAdminAccess() {
      return isSystemAdmin() || isLegacyAdmin();
    }

    function getMembership(schoolId) {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + schoolId));
    }

    function isSchoolAdmin(schoolId) {
      return hasAdminAccess()
        || (isAuthenticated()
            && getMembership(schoolId).data.role == 'school_admin');
    }

    function hasClassAccess(schoolId, classId) {
      return isSchoolAdmin(schoolId)
        || (isAuthenticated()
            && getMembership(schoolId).data.role in ['teacher', 'editor']
            && classId in getMembership(schoolId).data.classIds);
    }

    // ========================================
    // 学校データ
    // ========================================

    match /schools/{schoolId} {
      allow read: if hasAdminAccess()
        || (isAuthenticated() && exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + schoolId)));
      allow write: if hasAdminAccess();

      // 学年
      match /grades/{gradeId} {
        allow read: if true;
        allow write: if isSchoolAdmin(schoolId);

        // クラス
        match /classes/{classId} {
          allow read: if true;
          allow write: if isSchoolAdmin(schoolId);

          // 日次データ
          match /daily_data/{dateId} {
            allow read: if true;
            allow write: if hasClassAccess(schoolId, classId);
          }
        }
      }

      // デバイス管理
      match /devices/{deviceId} {
        allow read: if isSchoolAdmin(schoolId);
        allow write: if isSchoolAdmin(schoolId);
      }

      // エディター認証設定
      match /config/{configId} {
        allow read: if true;
        allow write: if hasAdminAccess() || isSchoolAdmin(schoolId);
      }

      // 旧classes（読み取り専用、移行用）
      match /classes/{classId} {
        allow read: if true;
        allow write: if false;
        match /daily_data/{dateId} {
          allow read: if true;
          allow write: if false;
        }
      }

      // 旧daily_data（読み取り専用、移行用）
      match /daily_data/{dateId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ========================================
    // メンバーシップ
    // ========================================

    match /memberships/{membershipId} {
      allow read: if hasAdminAccess()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if hasAdminAccess();
      allow update, delete: if hasAdminAccess()
        || isSchoolAdmin(resource.data.schoolId);
    }

    // ========================================
    // 管理者専用データ
    // ========================================

    match /settings/{settingId} {
      allow read, write: if hasAdminAccess();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow read, write: if hasAdminAccess();
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if hasAdminAccess();
    }

    match /logs/{logId} {
      allow read: if hasAdminAccess();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // デフォルト
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
