{
  "hosting": {
    "public": "management/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/manage/admin",
        "destination": "/manage/admin.html"
      },
      {
        "source": "/manage/school-admin",
        "destination": "/manage/school-admin.html"
      },
      {
        "source": "/manage/editor",
        "destination": "/manage/editor.html"
      },
      {
        "source": "/manage/editor-mobile",
        "destination": "/manage/editor-mobile.html"
      },
      {
        "source": "/manage/class-settings",
        "destination": "/manage/class-settings.html"
      },
      {
        "source": "/manage/login",
        "destination": "/manage/login.html"
      },
      {
        "source": "/manage",
        "destination": "/manage.html"
      }
    ],
    "redirects": [
      {
        "source": "/editor.html",
        "destination": "/manage/editor",
        "type": 301
      },
      {
        "source": "/editor-mobile.html",
        "destination": "/manage/editor-mobile",
        "type": 301
      },
      {
        "source": "/school-admin.html",
        "destination": "/manage/admin",
        "type": 301
      },
      {
        "source": "/class-settings.html",
        "destination": "/manage/class-settings",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=0"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": []
  }
}
