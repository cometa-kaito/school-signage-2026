rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // ヘルパー関数
    // ========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      return request.auth != null && request.auth.token.systemRole == 'system_admin';
    }

    function isLegacyAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function hasAdminAccess() {
      return isSystemAdmin() || isLegacyAdmin();
    }

    function getMembership(schoolId) {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + schoolId));
    }

    function isSchoolAdmin(schoolId) {
      return hasAdminAccess()
        || (isAuthenticated()
            && getMembership(schoolId).data.role == 'school_admin');
    }

    function hasClassAccess(schoolId, classId) {
      return isSchoolAdmin(schoolId)
        || (isAuthenticated()
            && getMembership(schoolId).data.role == 'teacher')
        || (isAuthenticated()
            && request.auth.token.teacher == true
            && request.auth.token.schoolId == schoolId);
    }

    // 掲示板コンテンツ（予定・連絡・提出物）の書き込み権限
    // クラス固有のデータだけでなく、学校/学科/学年マスターへの書き込みも許可する。
    // 広告や displaySettings など構造メタデータは対象外（学校管理者以上のみ）。
    function hasContentAccess(schoolId) {
      return isSchoolAdmin(schoolId)
        || (isAuthenticated()
            && getMembership(schoolId).data.role in ['teacher', 'editor'])
        || (isAuthenticated()
            && (request.auth.token.teacher == true || request.auth.token.editor == true)
            && request.auth.token.schoolId == schoolId);
    }

    // ========================================
    // 学校データ
    // ========================================

    match /schools/{schoolId} {
      allow read: if hasAdminAccess()
        || (isAuthenticated() && exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + schoolId)));
      allow write: if hasAdminAccess();

      // 学校マスター日次データ
      match /master_daily_data/{dateId} {
        allow read: if true;
        allow write: if hasContentAccess(schoolId);
      }

      // 学科（学年横断の軸）
      match /departments/{departmentId} {
        allow read: if true;
        allow write: if isSchoolAdmin(schoolId);

        // 学科マスター日次データ
        match /master_daily_data/{dateId} {
          allow read: if true;
          allow write: if hasContentAccess(schoolId);
        }
      }

      // 学年（クラスモード: 学校 > 学年 > クラス）
      match /grades/{gradeId} {
        allow read: if true;
        allow write: if isSchoolAdmin(schoolId);

        match /master_daily_data/{dateId} {
          allow read: if true;
          allow write: if hasContentAccess(schoolId);
        }

        match /classes/{classId} {
          allow read: if true;
          allow write: if isSchoolAdmin(schoolId);

          match /daily_data/{dateId} {
            allow read: if true;
            allow write: if hasClassAccess(schoolId, classId);
          }
        }
      }

      // 学科（学科モード: 学校 > 学科 > 学年 > クラス）
      match /departments/{departmentId} {
        allow read: if true;
        allow write: if isSchoolAdmin(schoolId);

        // 学科マスター
        match /master_daily_data/{dateId} {
          allow read: if true;
          allow write: if hasContentAccess(schoolId);
        }

        // 学科配下の学年
        match /grades/{gradeId} {
          allow read: if true;
          allow write: if isSchoolAdmin(schoolId);

          // 学年マスター（学科モード）
          match /master_daily_data/{dateId} {
            allow read: if true;
            allow write: if hasContentAccess(schoolId);
          }

          // 学科配下の学年配下のクラス
          match /classes/{classId} {
            allow read: if true;
            allow write: if isSchoolAdmin(schoolId);

            match /daily_data/{dateId} {
              allow read: if true;
              allow write: if hasClassAccess(schoolId, classId);
            }
          }
        }
      }

      // エディター認証設定
      match /config/{configId} {
        allow read: if true;
        allow write: if hasAdminAccess() || isSchoolAdmin(schoolId);
      }

      // 旧classes（読み取り専用、移行用）
      match /classes/{classId} {
        allow read: if true;
        allow write: if false;
        match /daily_data/{dateId} {
          allow read: if true;
          allow write: if false;
        }
      }

      // 旧daily_data（読み取り専用、移行用）
      match /daily_data/{dateId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ========================================
    // メンバーシップ
    // ========================================

    match /memberships/{membershipId} {
      allow read: if hasAdminAccess()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if hasAdminAccess();
      allow update, delete: if hasAdminAccess()
        || isSchoolAdmin(resource.data.schoolId);
    }

    // ========================================
    // 管理者専用データ
    // ========================================

    match /settings/{settingId} {
      allow read, write: if hasAdminAccess();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow read, write: if hasAdminAccess();
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if hasAdminAccess();
    }

    match /logs/{logId} {
      allow read: if hasAdminAccess();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ========================================
    // フィードバック (教員 → システム管理者)
    // 書き込みは Cloud Functions (submitFeedback) 経由のみ。
    // 読み取りはシステム管理者のみ。Trigger Email 用の mail/ も同様に CF 経由のみ。
    // ========================================

    match /feedback/{feedbackId} {
      allow read: if hasAdminAccess();
      allow write: if false; // クライアントからの直接書き込みは禁止（Cloud Functions 経由のみ）
    }

    match /mail/{mailId} {
      allow read, write: if false; // Trigger Email extension + Cloud Functions のみ
    }

    // デフォルト
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
