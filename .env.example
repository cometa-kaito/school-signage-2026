# ============================================================
# キミテラス 環境変数サンプル
# ============================================================
# このファイルを .env にコピーして値を設定してください。
# .env は .gitignore に登録済みで、リポジトリには含まれません。

# --- Firebase Admin SDK（管理スクリプト用） ---------------------
# サービスアカウントキーは リポジトリ外 に配置してください。
# Google 標準の環境変数名（firebase-admin が自動検出）
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# 代替: プロジェクト固有の環境変数
# KIMITERRACE_CREDENTIALS_PATH=/absolute/path/to/serviceAccountKey.json

# --- 管理者セットアップ（setup-admin.js） ----------------------
# 初回に system_admin ロールを付与するアカウント
ADMIN_EMAIL=admin@example.com

# --- Firebase プロジェクト設定（フロントエンド） ----------------
# management/ からビルド時に参照される値
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=school-signage-2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=school-signage-2026
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=school-signage-2026.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
